{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "url": "http://localhost:5173",
      "port": 5173
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "mvn",
      "runtimeArgs": [
        "-f",
        "backend/pom.xml",
        "spring-boot:run",
        "-Dspring-boot.run.profiles=dev"
      ],
      "port": 8080
    }
  ]
}
